# =============================================================================
# GlowMoon Shop - konfiguracja środowiska
# Skopiuj ten plik jako .env i uzupełnij własnymi wartościami.
# =============================================================================

# --- Serwer (server.js) ---
PORT=3001

# --- CashBill (platnosci - wymagane) ---
# Znajdziesz je w panelu CashBill (panel.cashbill.pl) jako:
# - Identyfikator punktu platnosci (np. twoja-domena.pl)
# - Klucz punktu platnosci
# (punkt platnosci musi byc skonfigurowany jako "Web Service")
CASHBILL_SHOP_ID=twoja-domena.pl
CASHBILL_SECRET_KEY=twoj-klucz-punktu-platnosci

# Adres bramki (domyslnie produkcja). Do testow odkomentuj testws:
# CASHBILL_API_BASE=https://pay.cashbill.pl/testws/rest/
# CASHBILL_API_BASE=https://pay.cashbill.pl/ws/rest/

# Publiczny adres Twojego sklepu (bez ukosnika na koncu) -
# uzywany do adresow powrotu po platnosci (/payment/success i /payment/failure)
PUBLIC_URL=https://twoja-domena.pl

# Peln adres webhooka, ktory musisz ustawic w panelu CashBill jako
# "Adres notyfikacji" (domyslnie zaklada API na tym samym hoscie co PUBLIC_URL)
CASHBILL_NOTIFY_URL=https://twoja-domena.pl/api/cashbill/notify

# --- Frontend (Vite) ---
# Ustaw tylko, jesli frontend i API dzialaja na roznych domenach.
# Domyslnie frontend uzywa wzglednych sciezek /api (w dev proxy na :3001).
# VITE_API_URL=https://api.twoja-domena.pl

# --- EmailJS (wysylka kodu 2FA z panelu admina) ---
# Skopiuj do pliku .env (lokalnie) i .env.production (przed buildem na hosting).
#
# Skad wziac wartosci (dashboard EmailJS):
#   - Email Services  -> Service ID nowej uslugi
#   - Email Templates -> Template ID szablonu (szablon musi miec zmienna {{code}},
#                        a pole "To Email" = {{to_email}})
#   - Account -> General -> Public Key
#
# Bez tych kluczy panel admina dziala w trybie DEV:
# kod 2FA wyswietli sie od razu w oknie alertu.

VITE_EMAILJS_SERVICE_ID=twoje_service_id
VITE_EMAILJS_TEMPLATE_ID=twoj_template_id
VITE_EMAILJS_PUBLIC_KEY=twoj_public_key

# Adres, na ktory wysylany jest kod 2FA (opcjonalne, domyslnie farencjuszek@gmail.com)
# W szablonie EmailJS pole "To Email" musi miec zmienna {{to_email}}, zeby to zadzialalo
VITE_ADMIN_EMAIL=email_administratora@example.com

# --- Mailjet (wysylka maili z serwera, opcjonalnie) ---
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAILJET_FROM_EMAIL=
# MAILJET_FROM_NAME=GlowMoon
# ADMIN_2FA_TO=

# --- Supabase (baza zamowien - wymagana na Vercel) ---
# Zaloz projekt: https://supabase.com/ (darmowy plan).
# Projekt Settings -> API: znajdziesz URL i klucze.
# Uzywaj klucza service_role TYLKO po stronie serwera (Vercel env), nigdy we frontendzie!
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=twoj-service-role-key
# Do lokalnego dev bez bazy serwer i tak zadziala na pliku data/orders.json

# --- Dostawa produktow (tryb pull przez plugin) ---
# Zalecane: hosting Minecraft (np. gamehost.pl) blokuje port RCON z internetu,
# wiec dostawa idzie przez plugin GlowMoonDelivery, ktory odpytuje backend:
#   GET  /api/delivery/poll?token=...  (plugin pobiera komendy do wykonania)
#   POST /api/delivery/ack             (plugin potwierdza wykonanie)
# Komenda wykonywana po oplaceniu: case give <nick> <klucz> <ilosc>
# Klucze musza zgadzac sie z nazwami kluczy w Twoim pluginie /case (np. Rzadka, Epicka, Legendarna, Survival).
# DELIVERY_TOKEN musi byc TAKI SAM w: .env, zmiennych srodowiskowych Vercel i config.yml pluginu.
DELIVERY_TOKEN=wygeneruj-przez-node-e-require-crypto-randomBytes-24-hex

# --- RCON (OPCJONALNIE, tylko jesli hosting otwiera port RCON na zewnatrz) ---
# Nie uzywane w trybie pluginu. Zostaw puste, jesli uzywasz plugina GlowMoonDelivery.
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=
